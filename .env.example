# Real nearby OpenStreetMap search needs no environment variables.
# Optional Photon-compatible HTTPS endpoint for submitted city/ZIP/address lookups.
# Defaults to https://photon.komoot.io/api/; no key is required for personal low-volume use.
# EXPO_PUBLIC_PLACE_SEARCH_URL=https://photon.komoot.io/api/
# Optional Google Places mode below: for iOS Simulator local development. A phone or published app needs an HTTPS backend URL.
EXPO_PUBLIC_STATIONS_API_URL=http://localhost:8787

# Server only. A Google Maps Demo Key can be used for evaluation without billing.
# Keep this in .env.local, which is gitignored. Never add EXPO_PUBLIC_ to this key.
GOOGLE_PLACES_API_KEY=replace-with-your-places-api-new-or-demo-key
STATIONS_HOST=127.0.0.1
STATIONS_PORT=8787
STATIONS_DAILY_LIMIT=100

# Separate api-learn FastAPI server. For a development phone build, use your Mac's private LAN IP.
EXPO_PUBLIC_SAMPLE_API_URL=http://localhost:8000
