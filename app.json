{
  "expo": {
    "name": "Centsward",
    "slug": "gasfinder",
    "scheme": "gasfinder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.gasfinder",
      "infoPlist": {
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true },
        "NSLocalNetworkUsageDescription": "Allow Centsward to connect to the sample gas price API running on your local network."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#122B2A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withIosBuildScriptAccess",
      "./plugins/withIosJsiSdkCache",
      "./plugins/withSpendingPauseExtension",
      "./plugins/withSubscriptionApps",
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Centsward to use your location to find nearby gas stations."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Centsward to select a gas receipt photo you choose to save in the app.",
          "cameraPermission": "Allow Centsward to photograph a gas receipt you choose to save in the app.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "AccountWidget",
              "displayName": "Centsward account",
              "description": "Your saved available balance and set-aside amount.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "accessoryRectangular"]
              }
            },
            {
              "name": "GoalProgressWidget",
              "displayName": "Savings goal",
              "description": "See your goal progress at a glance.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "accessoryRectangular"]
              }
            }
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your Centsward account records."
        }
      ]
    ]
  }
}
