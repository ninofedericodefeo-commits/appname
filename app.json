{
  "expo": {
    "name": "GasFinder",
    "slug": "gasfinder",
    "scheme": "gasfinder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.gasfinder"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#173A35",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withIosBuildScriptAccess",
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow GasFinder to use your location to find nearby gas stations."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GasFinder to select a gas receipt photo you choose to save in the app.",
          "cameraPermission": "Allow GasFinder to photograph a gas receipt you choose to save in the app.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "GoalProgressWidget",
              "displayName": "Savings goal",
              "description": "See your goal progress at a glance.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "accessoryRectangular"]
              }
            }
          ]
        }
      ]
    ]
  }
}
